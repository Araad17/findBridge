NODE_ENV=development
PORT=4000
# آدرس فرانت (برای CORS و لینک‌های ایمیل)
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgres://boursiye:boursiye@localhost:5432/boursiye
# حتماً در محیط واقعی یک مقدار تصادفی و طولانی بگذارید
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=7
JWT_REMEMBER_DAYS=30
# ایمیل (اختیاری). بدون SMTP، لینک‌ها فقط در لاگ سرور چاپ می‌شوند
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="بورسیه‌یار <no-reply@example.com>"
# حساب مدیر اولیه برای npm run seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345
# اختلاف منطقه زمانی نمایش با UTC به دقیقه (تهران = 210)
APP_TZ_OFFSET_MINUTES=210
MAX_UPLOAD_MB=10
